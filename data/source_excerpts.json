        "71": "    - name: Compute image tags",
        "72": "      id: tags",
        "73": "      run: |",
        "74": "        PREFIX=\"${{ inputs.image_tag || inputs.network }}\"",
        "75": "        TAGS=\"${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${PREFIX}-${{ matrix.node_size }}-latest\"",
        "76": "        if [ -n \"${{ steps.version.outputs.version }}\" ]; then",
        "77": "          TAGS=\"${TAGS},${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ inputs.network }}-${{ matrix.node_size }}-${{ steps.version.outputs.version }}\"",
        "78": "        fi",
        "79": "        echo \"tags=$TAGS\" >> \"$GITHUB_OUTPUT\"",
        "80": "    - name: Log in to Docker Hub",
        "81": "      uses: docker/login-action@v3",
        "82": "      with:",
        "83": "        registry: ${{ env.REGISTRY }}",
        "84": "        username: ${{ secrets.DOCKERHUB_USERNAME }}",
        "85": "        password: ${{ secrets.DOCKERHUB_TOKEN }}",
        "86": "    - name: Build and push Docker image",
        "87": "      uses: docker/build-push-action@v5",
        "88": "      with:",
        "89": "        context: .",
        "90": "        file: ./Dockerfile"
      },
      "notes": [
        "lines 71-90: build job: computes Docker image tags (mutable -latest tags) and builds/pushes images; no signing step"
      ]
    },
    ".github/workflows/testnet-build.yml": {
      "lines": {
        "28": "    needs: build-testnet",
        "29": "    runs-on: ubuntu-latest",
        "30": "    permissions:",
        "31": "      contents: write",
        "32": "    steps:",
        "33": "    - name: Checkout source",
        "34": "      uses: actions/checkout@v4",
        "35": "    - name: Extract version from source",
        "36": "      id: version",
        "37": "      run: |",
        "38": "        VERSION=$(grep -oP 'versionString\\s*=\\s*\"\\K[^\"]+' src/libxrpl/protocol/BuildInfo.cpp)",
        "39": "        if [ -z \"$VERSION\" ]; then",
        "40": "          echo \"::error::Could not extract version from BuildInfo.cpp\"",
        "41": "          exit 1",
        "42": "        fi",
        "43": "        echo \"version=$VERSION\" >> \"$GITHUB_OUTPUT\"",
        "44": "    - name: Publish GitHub release",
        "45": "      env:",
        "46": "        GH_TOKEN: ${{ github.token }}",
        "47": "        VERSION: ${{ steps.version.outputs.version }}",
        "48": "      run: |",
        "49": "        TAG=\"v$VERSION\"",
        "50": "        if gh release view \"$TAG\" --repo \"$GITHUB_REPOSITORY\" > /dev/null 2>&1; then",
        "51": "          echo \"Release $TAG already exists. Nothing to do.\"",
        "52": "          exit 0",
        "53": "        fi",
        "54": "        gh api --method POST \"repos/$GITHUB_REPOSITORY/releases/generate-notes\" \\",
        "55": "          -f tag_name=\"$TAG\" -f target_commitish=\"$GITHUB_SHA\" --jq .body > notes.md",
        "56": "        cat >> notes.md <<NOTES",
        "57": "",
        "58": "        ## Upgrade",
        "59": "",
        "60": "        Community validators run the rolling \\`-light-latest\\` tag, so an upgrade is a pull and a restart from the node directory:",
        "61": "",
        "62": "        \\`\\`\\`bash",
        "63": "        cd /opt/postfiatd",
        "64": "        docker compose pull",
        "65": "        docker compose up -d",
        "66": "        \\`\\`\\`",
        "67": "",
        "68": "        Confirm with \\`server_info\\` that \\`build_version\\` reads \\`$VERSION\\`. Images: \\`agtipft/postfiatd:testnet-{light,medium,full}-$VERSION\\`. Releases that need an extra step say so in the release's document under \\`docs/\\`.",
        "69": "        NOTES",
        "70": "        gh release create \"$TAG\" --repo \"$GITHUB_REPOSITORY\" --target \"$GITHUB_SHA\" \\",
        "71": "          --title \"$TAG\" --notes-file notes.md"
      },
      "notes": [
        "lines 40-71: release job: publishes a GitHub release with gh release create from generated notes; no signing, attestation, or checksum step in this job",
        "lines 28-39: release job: version is extracted from BuildInfo.cpp versionString"
      ]
    },
